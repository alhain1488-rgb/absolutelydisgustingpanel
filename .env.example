# ── Panel configuration ───────────────────────────────────────────────
# Copy to .env and fill in real secrets. The backend fails fast on start
# if any required variable is missing.

# Master key for AES-256-GCM encryption of secrets at rest.
# MUST be 32 random bytes, base64-encoded. Generate with:
#   openssl rand -base64 32
PANEL_ENCRYPTION_KEY=

# Secret used to sign JWT access/refresh tokens. Any long random string.
#   openssl rand -base64 48
PANEL_JWT_SECRET=

# Bootstrap admin account, created on first start if no admin exists.
PANEL_ADMIN_USERNAME=admin
PANEL_ADMIN_PASSWORD=

# Public domain the panel is served on (used by Caddy for auto-TLS and as
# the default base URL for subscription links).
PANEL_DOMAIN=panel.example.com

# ── Runtime ───────────────────────────────────────────────────────────
# Path to the SQLite database file (inside the backend container/volume).
DB_PATH=/data/panel.db

# Address the Go backend listens on.
PANEL_HTTP_ADDR=:8080

# Log level: debug | info | warn | error
LOG_LEVEL=info
